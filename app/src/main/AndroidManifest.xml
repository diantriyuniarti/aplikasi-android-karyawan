<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.projectakhir_noval_dian_nofal">
    <!-- Permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" /> <!-- Features -->
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProjectAkhir_Noval_Dian_Nofal"
        tools:targetApi="31">
        <activity
            android:name=".SpeechRecognizer"
            android:exported="false" />
        <!-- MainActivity - Entry Point -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- RegisterActivity -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" /> <!-- DashboardActivity -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" /> <!-- Sensor Activity -->
        <activity
            android:name=".sensorActivity"
            android:exported="false"
            android:label="Sensor Activity"
            android:parentActivityName=".DashboardActivity" /> <!-- Map Activity -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:label="Map Activity"
            android:parentActivityName=".DashboardActivity" /> <!-- Database Karyawan Activities -->
        <activity
            android:name=".InputDataKaryawanActivity"
            android:exported="false"
            android:label="Input Data Karyawan"
            android:parentActivityName=".DashboardActivity" />
        <activity
            android:name=".LihatDataActivity"
            android:exported="false"
            android:label="Daftar Karyawan"
            android:parentActivityName=".DashboardActivity" />
    </application>

</manifest>